<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="HomeQuickActionStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_marginBottom">34dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="HomeQuickIconCircleStyle">
        <item name="android:layout_width">86dp</item>
        <item name="android:layout_height">86dp</item>
        <item name="android:background">@drawable/bg_home_quick_circle</item>
    </style>

    <style name="HomeQuickIconStyle">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:tint">#4B626A</item>
    </style>

    <style name="HomeQuickLabelStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textColor">#181C20</item>
        <item name="android:textSize">17sp</item>
    </style>


    <style name="SleepMetricCardStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">78dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">42dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>

    <style name="SleepMetricIconStyle">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_sleep_metric_icon</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#4B626A</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="SleepMetricTextGroupStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">24dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="SleepMetricLabelStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#42484A</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="SleepMetricValueStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">3dp</item>
        <item name="android:textColor">#181C20</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SleepBottomNavItemStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#181C20</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="SleepBottomNavSelectedStyle" parent="SleepBottomNavItemStyle">
        <item name="android:background">@drawable/bg_home_nav_selected</item>
        <item name="android:textColor">#795D43</item>
    </style>

    <style name="ReportMetricCardBlueStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:background">@drawable/bg_report_metric_blue</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">26dp</item>
        <item name="android:paddingEnd">22dp</item>
    </style>

    <style name="ReportMetricCardPeachStyle" parent="ReportMetricCardBlueStyle">
        <item name="android:background">@drawable/bg_report_metric_peach</item>
    </style>

    <style name="ReportMetricCardGrayStyle" parent="ReportMetricCardBlueStyle">
        <item name="android:background">@drawable/bg_report_metric_gray</item>
    </style>

    <style name="ReportMetricIconStyle">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:background">@drawable/bg_sleep_metric_icon</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#4B626A</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="ReportMetricTextGroupStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">18dp</item>
        <item name="android:orientation">vertical</item>
    </style>

    <style name="ReportMetricLabelStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#42484A</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="ReportMetricValueStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">#181C20</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ReportGuideStepStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">#795D43</item>
        <item name="android:textSize">14sp</item>
    </style>


    <style name="ProfileFieldLabelStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#4B626A</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="ProfileEditTextStyle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">58dp</item>
        <item name="android:background">@drawable/bg_profile_input</item>
        <item name="android:paddingStart">28dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:textColor">#181C20</item>
        <item name="android:textColorHint">#72787A</item>
        <item name="android:textSize">16sp</item>
    </style>

</resources>
