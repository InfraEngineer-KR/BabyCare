<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FF">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/profileScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="150dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="뒤로가기"
                android:padding="7dp"
                android:src="@drawable/outline_arrow_back_24"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="#4B626A" />

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:text="프로필 수정"
                android:textColor="#4B626A"
                android:textSize="31sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/btn_back"
                app:layout_constraintEnd_toStartOf="@id/ivProfileAvatar"
                app:layout_constraintStart_toEndOf="@id/btn_back"
                app:layout_constraintTop_toTopOf="@id/btn_back" />

            <ImageView
                android:id="@+id/ivProfileAvatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_home_profile_circle"
                android:contentDescription="프로필"
                android:padding="7dp"
                android:src="@drawable/human"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <FrameLayout
                android:id="@+id/profileHeroCard"
                android:layout_width="match_parent"
                android:layout_height="202dp"
                android:layout_marginTop="46dp"
                android:background="@drawable/bg_profile_hero_card"
                app:layout_constraintTop_toBottomOf="@id/tv_title">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="bottom|start"
                    android:orientation="vertical"
                    android:paddingStart="28dp"
                    android:paddingEnd="28dp"
                    android:paddingBottom="26dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:text="당신의 여정"
                        android:textColor="#4B626A"
                        android:textSize="34sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="아래에서 소중한 공간의 정보를 수정하세요."
                        android:textColor="#181C20"
                        android:textSize="17sp" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/label_name"
                style="@style/ProfileFieldLabelStyle"
                android:layout_marginTop="56dp"
                android:text="성함"
                app:layout_constraintTop_toBottomOf="@id/profileHeroCard" />

            <EditText
                android:id="@+id/et_edit_name"
                style="@style/ProfileEditTextStyle"
                android:layout_marginTop="16dp"
                android:hint="Elena Rivers"
                android:inputType="textPersonName"
                app:layout_constraintTop_toBottomOf="@id/label_name" />

            <TextView
                android:id="@+id/label_baby_birth"
                style="@style/ProfileFieldLabelStyle"
                android:layout_marginTop="28dp"
                android:text="아이 생일"
                app:layout_constraintTop_toBottomOf="@id/et_edit_name" />

            <EditText
                android:id="@+id/et_edit_baby_birth"
                style="@style/ProfileEditTextStyle"
                android:layout_marginTop="16dp"
                android:drawableEnd="@drawable/outline_arrow_downward_alt_24"
                android:focusable="false"
                android:hint="2023-11-15"
                app:layout_constraintTop_toBottomOf="@id/label_baby_birth" />

            <View
                android:id="@+id/divider1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="54dp"
                android:background="#D7DAE0"
                app:layout_constraintTop_toBottomOf="@id/et_edit_baby_birth" />

            <TextView
                android:id="@+id/tvSecurityTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="sans-serif-medium"
                android:text="보안 설정"
                android:textColor="#4B626A"
                android:textSize="25sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/divider1" />

            <TextView
                android:id="@+id/label_current_pw"
                style="@style/ProfileFieldLabelStyle"
                android:layout_marginTop="30dp"
                android:text="현재 비밀번호"
                app:layout_constraintTop_toBottomOf="@id/tvSecurityTitle" />

            <EditText
                android:id="@+id/et_current_pw"
                style="@style/ProfileEditTextStyle"
                android:layout_marginTop="16dp"
                android:hint="••••••••"
                android:inputType="textPassword"
                app:layout_constraintTop_toBottomOf="@id/label_current_pw" />

            <TextView
                android:id="@+id/label_edit_pw"
                style="@style/ProfileFieldLabelStyle"
                android:layout_marginTop="28dp"
                android:text="새 비밀번호"
                app:layout_constraintTop_toBottomOf="@id/et_current_pw" />

            <EditText
                android:id="@+id/et_edit_pw"
                style="@style/ProfileEditTextStyle"
                android:layout_marginTop="16dp"
                android:hint="최소 8자 이상"
                android:inputType="textPassword"
                app:layout_constraintTop_toBottomOf="@id/label_edit_pw" />

            <View
                android:id="@+id/divider2"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/et_edit_pw" />

            <TextView
                android:id="@+id/label_guardian"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="52dp"
                android:fontFamily="sans-serif-medium"
                android:text="공동 양육자"
                android:textColor="#4B626A"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/btn_add_guardian"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/et_edit_pw" />

            <ImageButton
                android:id="@+id/btn_add_guardian"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_profile_add_button"
                android:contentDescription="공동 양육자 추가"
                android:padding="12dp"
                android:scaleType="center"
                android:src="@drawable/plus"
                app:layout_constraintBottom_toBottomOf="@id/label_guardian"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/label_guardian" />

            <LinearLayout
                android:id="@+id/layout_guardian_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:animateLayoutChanges="true"
                android:background="@drawable/bg_profile_empty_card"
                android:orientation="vertical"
                android:padding="28dp"
                app:layout_constraintTop_toBottomOf="@id/label_guardian">

                <LinearLayout
                    android:id="@+id/item_empty_guardian"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:background="@drawable/bg_profile_empty_icon"
                        android:gravity="center"
                        android:text="♙"
                        android:textColor="#9DB9C4"
                        android:textSize="28sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="22dp"
                        android:layout_weight="1"
                        android:lineSpacingExtra="3dp"
                        android:text="추가된 공동 양육자가 없습니다.\n배우자나 가족과 아이의 성장을 공유하세요."
                        android:textColor="#72787A"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:id="@+id/divider3"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/layout_guardian_list" />

            <TextView
                android:id="@+id/label_smartthings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:fontFamily="sans-serif-medium"
                android:text="SmartThings 연동"
                android:textColor="#4B626A"
                android:textSize="24sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toStartOf="@id/btn_add_smartthings"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layout_guardian_list" />

            <ImageButton
                android:id="@+id/btn_add_smartthings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_profile_add_button"
                android:contentDescription="SmartThings 추가"
                android:padding="12dp"
                android:scaleType="center"
                android:src="@drawable/plus"
                app:layout_constraintBottom_toBottomOf="@id/label_smartthings"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/label_smartthings" />

            <TextView
                android:id="@+id/tv_smartthings_desc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:background="@drawable/bg_profile_smartthings_card"
                android:drawableStart="@android:drawable/stat_sys_data_bluetooth"
                android:drawablePadding="14dp"
                android:lineSpacingExtra="4dp"
                android:paddingStart="28dp"
                android:paddingTop="24dp"
                android:paddingEnd="28dp"
                android:paddingBottom="24dp"
                android:text="삼성 Smart Access 토큰(PAT) 동기화"
                android:textColor="#4B626A"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/label_smartthings" />

            <LinearLayout
                android:id="@+id/item_empty_device"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="28dp"
                android:layout_marginTop="-8dp"
                android:layout_marginEnd="28dp"
                android:background="@drawable/bg_profile_device_empty_row"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_smartthings_desc">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_info_details"
                    app:tint="#92989B" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:text="연결된 스마트 기기가 없습니다."
                    android:textColor="#42484A"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_device_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:animateLayoutChanges="true"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/item_empty_device" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <Button
        android:id="@+id/btn_save_all"
        android:layout_width="0dp"
        android:layout_height="104dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_profile_save_button"
        android:drawableStart="@android:drawable/ic_menu_save"
        android:drawablePadding="14dp"
        android:insetLeft="0dp"
        android:insetTop="0dp"
        android:insetRight="0dp"
        android:insetBottom="0dp"
        android:minHeight="0dp"
        android:minWidth="0dp"
        android:paddingStart="34dp"
        android:paddingEnd="34dp"
        android:text="모든 변경사항\n저장"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
