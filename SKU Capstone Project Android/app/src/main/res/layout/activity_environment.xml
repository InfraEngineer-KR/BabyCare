<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FF">

    <ScrollView
        android:id="@+id/smartThingsScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="104dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="34dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/smartThingsHeader"
                android:layout_width="match_parent"
                android:layout_height="62dp">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="뒤로가기"
                    android:padding="9dp"
                    android:src="@drawable/outline_arrow_back_24"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="#4B626A" />

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="12dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:text="SmartThings 연동"
                    android:textColor="#4B626A"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/btnBack"
                    app:layout_constraintEnd_toStartOf="@id/ivSmartThingsProfile"
                    app:layout_constraintStart_toEndOf="@id/btnBack"
                    app:layout_constraintTop_toTopOf="@id/btnBack" />

                <ImageView
                    android:id="@+id/ivSmartThingsProfile"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:background="@drawable/bg_home_profile_circle"
                    android:contentDescription="프로필"
                    android:padding="8dp"
                    android:src="@drawable/human"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/blockAutoControl"
                android:layout_width="match_parent"
                android:layout_height="142dp"
                android:layout_marginTop="48dp"
                android:background="@drawable/bg_smartthings_white_card"
                android:paddingStart="28dp"
                android:paddingTop="28dp"
                android:paddingEnd="24dp"
                android:paddingBottom="28dp">

                <TextView
                    android:id="@+id/tvAutoControlTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="자동 제어 모드"
                    android:textColor="#181C20"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/switchAutoControl"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvAutoControlSubtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:lineSpacingExtra="4dp"
                    android:text="아기의 수면 패턴에 맞춰 환경을 조절합니다."
                    android:textColor="#42484A"
                    android:textSize="18sp"
                    app:layout_constraintEnd_toStartOf="@id/switchAutoControl"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvAutoControlTitle" />

                <Switch
                    android:id="@+id/switchAutoControl"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:showText="false"
                    android:thumbTint="#FFFFFF"
                    android:trackTint="#4B626A"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/blockTemhu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="44dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cardTemperature"
                    android:layout_width="0dp"
                    android:layout_height="222dp"
                    android:layout_marginEnd="14dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_smartthings_white_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/bg_smartthings_temp_icon"
                        android:gravity="center"
                        android:text="♨"
                        android:textColor="#4B626A"
                        android:textSize="28sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="현재 온도"
                        android:textColor="#42484A"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCurrentTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:text="23.5°C"
                        android:textColor="#4B626A"
                        android:textSize="40sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="78dp"
                        android:layout_height="30dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_smartthings_temp_badge"
                        android:gravity="center"
                        android:text="쾌적함"
                        android:textColor="#4B626A"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardHumidity"
                    android:layout_width="0dp"
                    android:layout_height="222dp"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_smartthings_white_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:background="@drawable/bg_smartthings_humidity_icon"
                        android:gravity="center"
                        android:text="♢"
                        android:textColor="#795D43"
                        android:textSize="28sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="현재 습도"
                        android:textColor="#42484A"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCurrentHumid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false"
                        android:text="53.2%"
                        android:textColor="#795D43"
                        android:textSize="40sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="70dp"
                        android:layout_height="30dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_smartthings_humidity_badge"
                        android:gravity="center"
                        android:text="적정"
                        android:textColor="#795D43"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvConnectedDevicesTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="46dp"
                android:fontFamily="sans-serif-medium"
                android:text="연결된 기기"
                android:textColor="#181C20"
                android:textSize="28sp"
                android:textStyle="bold" />

            <FrameLayout
                android:id="@+id/devicePanel"
                android:layout_width="match_parent"
                android:layout_height="470dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_smartthings_device_panel"
                android:padding="26dp">

                <LinearLayout
                    android:id="@+id/emptyDeviceContent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="92dp"
                        android:layout_height="92dp"
                        android:background="@drawable/bg_smartthings_empty_icon"
                        android:gravity="center"
                        android:text="⌁"
                        android:textColor="#72787A"
                        android:textSize="42sp" />

                    <TextView
                        android:id="@+id/tvNoDevice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="34dp"
                        android:gravity="center"
                        android:text="연동된 기기가 없습니다"
                        android:textColor="#181C20"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:layout_width="240dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center"
                        android:lineSpacingExtra="6dp"
                        android:text="SmartThings 앱에서 새로운 스마트 기기를 추가하고 첫걸음과 동기화하세요."
                        android:textColor="#42484A"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/btnFindDevice"
                        android:layout_width="170dp"
                        android:layout_height="54dp"
                        android:layout_marginTop="42dp"
                        android:background="@drawable/bg_smartthings_find_button"
                        android:gravity="center"
                        android:text="기기 찾기"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvDevices"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/cardDeviceTip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="44dp"
                android:background="@drawable/bg_smartthings_tip_card"
                android:orientation="horizontal"
                android:paddingStart="28dp"
                android:paddingTop="24dp"
                android:paddingEnd="28dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:gravity="center"
                    android:text="ⓘ"
                    android:textColor="#795D43"
                    android:textSize="24sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="팁: 기기 최적화"
                        android:textColor="#795D43"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="4dp"
                        android:text="구성된 기기가 수면 공간 가까이에 있을수록 아기의 방 환경을 더 안정적으로 조절할 수 있습니다."
                        android:textColor="#795D43"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/smartThingsBottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:background="@drawable/bg_home_bottom_nav"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView style="@style/SleepBottomNavItemStyle" android:text="⌂\n홈" />
        <TextView style="@style/SleepBottomNavItemStyle" android:text="☾\n수면" />
        <TextView style="@style/SleepBottomNavItemStyle" android:text="▣\n일정" />
        <TextView style="@style/SleepBottomNavSelectedStyle" android:text="⌾\n가이드" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
