<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F9FF"
    tools:context=".GptReportActivity">

    <ScrollView
        android:id="@+id/reportScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="104dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="34dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/reportHeader"
                android:layout_width="match_parent"
                android:layout_height="42dp">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="뒤로가기"
                    android:focusable="true"
                    android:padding="7dp"
                    android:src="@drawable/outline_arrow_back_24"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="#4B626A" />

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:text="AI 수면 리포트"
                    android:textColor="#184C5A"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/btnBack"
                    app:layout_constraintStart_toEndOf="@id/btnBack"
                    app:layout_constraintTop_toTopOf="@id/btnBack" />

                <ImageView
                    android:id="@+id/ivReportProfile"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_home_profile_circle"
                    android:contentDescription="프로필"
                    android:padding="5dp"
                    android:src="@drawable/human"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tvReportDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="⌗  2025년 6월 8일 · 6월 9일"
                android:textColor="#42484A"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvReportTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:text="첫걸음: 아이들의 밤 기록"
                android:textColor="#181C20"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReportSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:lineSpacingExtra="5dp"
                android:text="아이들은 저녁 시간에 다소 뒤척였지만, 새벽에는 안정적인 모습을 보였습니다. 아이의 수면에 영향을 준 주된 환경 요인들을 살펴볼까요?"
                android:textColor="#42484A"
                android:textSize="14sp" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardReportScore"
                android:layout_width="match_parent"
                android:layout_height="264dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_report_score_card"
                android:paddingStart="28dp"
                android:paddingTop="30dp"
                android:paddingEnd="28dp"
                android:paddingBottom="28dp">

                <TextView
                    android:id="@+id/tvMorningInsightBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_report_badge_peach"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="오늘 아침의 인사이트"
                    android:textColor="#795D43"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvScoreLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="26dp"
                    android:text="수면 점수"
                    android:textColor="#181C20"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvMorningInsightBadge" />

                <TextView
                    android:id="@+id/tvReportScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:text="66"
                    android:textColor="#4B626A"
                    android:textSize="54sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvScoreLabel" />

                <TextView
                    android:id="@+id/tvScoreMax"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="/ 100"
                    android:textColor="#181C20"
                    android:textSize="14sp"
                    app:layout_constraintBaseline_toBaselineOf="@id/tvReportScore"
                    app:layout_constraintStart_toEndOf="@id/tvReportScore" />

                <TextView
                    android:id="@+id/tvReportScoreBody"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:lineSpacingExtra="4dp"
                    android:text="지난밤 수면의 질은 '보통' 수준입니다. 약 10회 정도 잠에서 깨었으며, 이는 깊은 수면 단계에 머무르는 데 다소 어려움이 있었음을 시사합니다."
                    android:textColor="#42484A"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvReportScore" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/reportMetricCards"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:orientation="vertical">

                <LinearLayout style="@style/ReportMetricCardBlueStyle">
                    <TextView style="@style/ReportMetricIconStyle" android:text="♨" />
                    <LinearLayout style="@style/ReportMetricTextGroupStyle">
                        <TextView style="@style/ReportMetricLabelStyle" android:text="평균 온도" />
                        <TextView style="@style/ReportMetricValueStyle" android:text="20°C" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/ReportMetricCardPeachStyle">
                    <TextView style="@style/ReportMetricIconStyle" android:text="♢" />
                    <LinearLayout style="@style/ReportMetricTextGroupStyle">
                        <TextView style="@style/ReportMetricLabelStyle" android:text="습도" />
                        <TextView style="@style/ReportMetricValueStyle" android:text="60%" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout style="@style/ReportMetricCardGrayStyle">
                    <TextView style="@style/ReportMetricIconStyle" android:text="◉" />
                    <LinearLayout style="@style/ReportMetricTextGroupStyle">
                        <TextView style="@style/ReportMetricLabelStyle" android:text="소음 수준" />
                        <TextView style="@style/ReportMetricValueStyle" android:text="50dB" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardPatternAnalysis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_report_white_card"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▥  수면 패턴 분석"
                    android:textColor="#181C20"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReportContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:lineSpacingExtra="5dp"
                    android:text="수면 분포가 고르지 않았습니다. 오후 11시에서 오전 2시 사이에 잦은 깨어남이 기록되었습니다. 데이터에 따르면 더 안정적인 수면을 위해 환경적인 개선이 필요해 보입니다."
                    android:textColor="#42484A"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardEnvironmentAnalysis"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_report_white_card"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⊘  수면 환경 분석"
                    android:textColor="#181C20"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:lineSpacingExtra="5dp"
                    android:text="온도와 습도는 신생아에게 적정한 범위였습니다. 다만, 소음 수준이 50dB로 다소 높습니다. 지속적인 소음은 얕은 잠 단계에서 잠을 방해할 수 있으므로 백색 소음기 사용을 고려해 보세요."
                    android:textColor="#42484A"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardTonightGuide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_report_guide_card"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingTop="28dp"
                android:paddingEnd="28dp"
                android:paddingBottom="28dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:text="오늘 밤을 위한 케어 가이드"
                    android:textColor="#181C20"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView style="@style/ReportGuideStepStyle" android:text="1    주변 소음 최소화하기\n외부 소음을 줄이고 필요한 경우 백색 소음기를 사용하여 일정한 청각적 보호막을 만들어주세요." />
                <TextView style="@style/ReportGuideStepStyle" android:text="2    취침 의식 만들기\n자기 전 부드러운 목소리로 대화하거나 잔잔한 음악을 들려주어 아이가 정서적으로 안정될 느끼게 해주세요." />
                <TextView style="@style/ReportGuideStepStyle" android:text="3    침구의 편안함 확인\n침구가 포근하고 온도에 적합한지 확인하여 아이들이 안정감을 느끼며 잘 수 있도록 도와주세요." />

                <FrameLayout
                    android:id="@+id/reportGuideImage"
                    android:layout_width="match_parent"
                    android:layout_height="188dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_report_night_image">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="✦"
                        android:textColor="#FFF4E8"
                        android:textSize="64sp" />
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvReportQuote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="“아이들의 편안한 잠을 위해 환경을 계속 돌봐주세요. 작은 변화가 더 평온한 밤을 만들어줍니다.”"
                android:textColor="#42484A"
                android:textSize="14sp"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/btnShareReport"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginStart="44dp"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="44dp"
                android:background="@drawable/bg_report_share_button"
                android:gravity="center"
                android:text="리포트 공유하기"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/reportBottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:background="@drawable/bg_home_bottom_nav"
        android:elevation="10dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView style="@style/SleepBottomNavItemStyle" android:text="⌂\n홈" />
        <TextView style="@style/SleepBottomNavItemStyle" android:text="☾\n수면" />
        <TextView style="@style/SleepBottomNavSelectedStyle" android:text="▣\n일정" />
        <TextView style="@style/SleepBottomNavItemStyle" android:text="⌾\n정책" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
